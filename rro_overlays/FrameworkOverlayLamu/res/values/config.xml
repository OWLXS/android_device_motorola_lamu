<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The bounding path of the cutout region of the main built-in display.
         Must either be empty if there is no cutout region, or a string that is parsable by
         {@link android.util.PathParser}.

         The path is assumed to be specified in display coordinates with pixel units and in
         the display's native orientation, with the origin of the coordinate system at the
         center top of the display. Optionally, you can append either `@left` or `@right` to the
         end of the path string, in order to change the path origin to either the top left,
         or top right of the display.

         To facilitate writing device-independent emulation overlays, the marker `@dp` can be
         appended after the path string to interpret coordinates in dp instead of px units.
         Note that a physical cutout should be configured in pixels for the best results.

         If the display supports multiple resolutions, please define the path config based on the
         highest resolution so that it can be scaled correctly in each resolution.

         Example for a 10px x 10px square top-center cutout:
                <string ...>M -5,0 L -5,10 L 5,10 L 5,0 Z</string>
         Example for a 10dp x 10dp square top-center cutout:
                <string ...>M -5,0 L -5,10 L 5,10 L 5,0 Z @dp</string>

         @see https://www.w3.org/TR/SVG/paths.html#PathData
         -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">
        M -36,0 L 36,0 L 36,102 L -36,102 Z
    </string>

    <!-- Like config_mainBuiltInDisplayCutout, but this path is used to report the
         one single bounding rect per device edge to the app via
         {@link DisplayCutout#getBoundingRect}. Note that this path should try to match the visual
         appearance of the cutout as much as possible, and may be smaller than
         config_mainBuiltInDisplayCutout
         -->
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">
        M -36,0 L 36,0 L 36,102 L -36,102 Z
    </string>

    <!-- lamu: ZramWriteback.scheduleZramWriteback() (StorageManagerService)
         is only called when this is true. It schedules BOTH idle-page
         marking and the writeback-to-disk job, but ZramWriteback itself
         checks /sys/block/zram0/backing_dev and no-ops the writeback half
         when it reads "none" (our case - no backing device configured,
         deliberately, no measured gain). We only want the idle-marking
         half, as a prerequisite for CONFIG_ZRAM_MULTI_COMP recompress
         (type=idle), which needs pages already marked idle to find
         anything to recompress. -->
    <bool name="config_zramWriteback">true</bool>

    <!-- lamu: ProcessList.updateOomLevels() (frameworks/base/services/core/
         java/com/android/server/am/ProcessList.java) computes the minfree
         thresholds lmkd kills at (sys.lmk.minfree_levels) from a per-level
         low/high table, scaled by total RAM - at our ~3.8GB this always
         clamps to the "high" end of that table (scale=1.0, since the scale
         formula saturates above 700MB), so this device gets the most
         generous/latest-possible kill thresholds the framework has, same
         as a flagship. Measured live on real hardware (04/10): cached-app
         threshold sits at 80640 pages (~315MB free) before lmkd will even
         consider killing a cached app, with 732 resident tasks and RAM
         98.8% full at the time. This adjust is added proportionally to
         every level (see updateOomLevels(): mOomMinFree[i] += adjust *
         mOomMinFree[i] / mOomMinFree[last]), so the cached-app level moves
         the most, foreground/visible move least. +12288 (12MB) is a
         moderate starting point - nudges lmkd to reclaim cached apps a
         bit sooner given how many tasks this device keeps resident, not a
         tuned-on-device final value. Revisit with scripts/ui-bench once
         this build actually runs on hardware (see
         kernellamu-device-load-diagnostico-dstate-swap memory for the
         measurement this is based on). -->
    <integer name="config_lowMemoryKillerMinFreeKbytesAdjust">12288</integer>
</resources>
